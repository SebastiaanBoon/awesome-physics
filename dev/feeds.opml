    <ownerName>Awesome Physics contributors</ownerName>
    <ownerEmail>awesome-physics@example.org</ownerEmail>
  </head>
  <body>
    <outline text="Preprints" title="Preprints">
      <outline type="rss" text="arXiv Physics" title="arXiv Physics" xmlUrl="https://export.arxiv.org/rss/physics" htmlUrl="https://arxiv.org/list/physics/recent" />
      <outline type="rss" text="arXiv Astrophysics" title="arXiv Astrophysics" xmlUrl="https://export.arxiv.org/rss/astro-ph" htmlUrl="https://arxiv.org/list/astro-ph/recent" />
      <outline type="rss" text="arXiv Condensed Matter" title="arXiv Condensed Matter" xmlUrl="https://export.arxiv.org/rss/cond-mat" htmlUrl="https://arxiv.org/list/cond-mat/recent" />
