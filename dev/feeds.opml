      <outline type="rss" text="arXiv High Energy Physics - Theory" title="arXiv High Energy Physics - Theory" xmlUrl="https://export.arxiv.org/rss/hep-th" htmlUrl="https://arxiv.org/list/hep-th/recent" />
      <outline type="rss" text="arXiv High Energy Physics - Phenomenology" title="arXiv High Energy Physics - Phenomenology" xmlUrl="https://export.arxiv.org/rss/hep-ph" htmlUrl="https://arxiv.org/list/hep-ph/recent" />
      <outline type="rss" text="arXiv Nuclear Theory" title="arXiv Nuclear Theory" xmlUrl="https://export.arxiv.org/rss/nucl-th" htmlUrl="https://arxiv.org/list/nucl-th/recent" />
      <outline type="rss" text="arXiv Quantum Physics" title="arXiv Quantum Physics" xmlUrl="https://export.arxiv.org/rss/quant-ph" htmlUrl="https://arxiv.org/list/quant-ph/recent" />
      <outline type="rss" text="arXiv RSS documentation" title="arXiv RSS documentation" xmlUrl="https://info.arxiv.org/help/rss.html" htmlUrl="https://arxiv.org/" />
    </outline>
