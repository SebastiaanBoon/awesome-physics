      <outline type="rss" text="ScienceDaily Physics" title="ScienceDaily Physics" xmlUrl="https://www.sciencedaily.com/rss/matter_energy/physics.xml" htmlUrl="https://www.sciencedaily.com/news/matter_energy/physics/" />
